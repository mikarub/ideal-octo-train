# quests/hollowbridge_factory.py

from ui.animated_text import animated_text, animated_effect
from ui.spinner_input import spinner_input
from engine.utils import timed_challenge
# quests/hollowbridge_factory.py
# A full rewrite of the Hollowbridge Factory quest as a branching, interactive scene pack.
# Replace your existing factory quest module with this code.

import time
import random

# NOTE: this module expects the following helper functions to exist
# in your project environment (they were present in your repo previously):
#   animated_text(text, color=..., speed=...)
#   animated_effect(text, effect_type)
#   spinner_input(prompt, theme)
#   timed_challenge(prompt, required_key, theme, stats, inventory, timeout=..., effects=None, reward_item=None)
#
# Save helpers (best-effort imports; fallbacks provided)
try:
    from engine.save_system import save_game_slot, quick_save
except Exception:
    try:
        from save_system.save_system import save_game_slot, quick_save
    except Exception:
        save_game_slot = None
        quick_save = None


# ---------------------------
# small utility helpers
# ---------------------------
def autosave_if_possible(save_state, stats, inventory, visited=None, choices=None, notes=""):
    """Save to chosen slot or quicksave; silent on failure."""
    player = {"hp": stats.get("Health", 10), "items": inventory.copy()}
    visited = visited if visited is not None else save_state.get("visited", {})
    choices = choices if choices is not None else save_state.get("choices", {})
    notes = notes or save_state.get("notes", "")

    if save_game_slot and save_state.get("last_slot"):
        try:
            save_game_slot(save_state["last_slot"], player, visited, choices, notes, stats, inventory)
        except Exception:
            # fallback to quick save if available
            if quick_save:
                try:
                    quick_save(player, visited, choices, notes, stats, inventory)
                except Exception:
                    pass
    elif quick_save:
        try:
            quick_save(player, visited, choices, notes, stats, inventory)
        except Exception:
            pass


def present_choices(prompt, options, theme):
    """
    Present options (list of strings). Returns the selected option string (lowercased).
    Uses spinner_input for consistent UI.
    """
    opts = " / ".join(options)
    resp = spinner_input(f"{prompt}\n[{opts}]: ", theme)
    return resp.strip().lower()


# ---------------------------
# Scenes / nodes
# ---------------------------
def entry_scene(stats, inventory, theme, save_state):
    animated_text("\nYou pull the factory gate and step into the chill of Hollowbridge.", color=theme["text_color"])
    animated_text("A single bulb gutters overhead; the factory breathes in slow, metallic inhales.", color=theme["text_color"])

    save_state.setdefault("visited", {})
    save_state.setdefault("choices", {})

    if not save_state["visited"].get("entry_first"):
        animated_effect("A poster flaps on the wall: 'HOLLOWBRIDGE MECHANICS — SHIFT PATTERNS: NIGHT OPERATIVE.'", "info")
        save_state["visited"]["entry_first"] = True
        autosave_if_possible(save_state, stats, inventory)

    choice = present_choices("Where do you go?", ["hall", "workshop", "stairs", "leave"], theme)

    if choice == "hall":
        return "hall"
    if choice == "workshop":
        return "workshop"
    if choice == "stairs":
        return "stairs"
    if choice == "leave":
        animated_text("The cold outside looks almost kinder than this place. You step back into the street.", color=theme["text_color"])
        return "exit"
    animated_effect("You hesitate, the dust listening.", "warning")
    return "entry"


def hall_scene(stats, inventory, theme, save_state):
    animated_text("\nThe main hall is filled with rusted machines. Conveyors lie like sleeping bones.", color=theme["text_color"])

    if not save_state["visited"].get("hall_first"):
        animated_effect("Something glints in the rubble near a machine base.", "info")
        save_state["visited"]["hall_first"] = True
        autosave_if_possible(save_state, stats, inventory)

    options = ["inspect rubble", "listen", "go workshop", "go stairs", "return"]

    choice = present_choices("What do you do?", options, theme)

    if choice in ("inspect rubble", "inspect", "inspect rubble."):
        if "brass_gear" not in inventory:
            animated_effect("You find a brass gear, pitted but serviceable.", "info")
            inventory.append("brass_gear")
            autosave_if_possible(save_state, stats, inventory)
        else:
            animated_effect("Only dust greets your hands.", "info")
        return "hall"
    if choice == "listen":
        animated_text("Beneath the factory's breath you hear a faint rhythmic clank to the north.", color=theme["text_color"])
        return "hall"
    if choice == "go workshop":
        return "workshop"
    if choice == "go stairs":
        return "stairs"
    if choice == "return":
        return "entry"
    animated_effect("You fumble and do nothing.", "warning")
    return "hall"


def workshop_scene(stats, inventory, theme, save_state):
    animated_text("\nThe workshop smells of oil and old solder. Benches lie cluttered with tools and half-built things.", color=theme["text_color"])

    # interactions: search bench, repair attempt, back
    options = ["search bench", "repair attempt", "go hall", "go storage", "return"]
    choice = present_choices("Actions:", options, theme)

    if choice == "search bench":
        if "precision_screwdriver" not in inventory:
            animated_effect("You find a precision screwdriver beneath a coil of wire.", "info")
            inventory.append("precision_screwdriver")
            autosave_if_possible(save_state, stats, inventory)
        else:
            animated_effect("Only old blueprints and a cold tea mug remain.", "info")
        return "workshop"

    if choice == "repair attempt":
        # small skill check using Agility or Luck
        # prefer using existing timed_challenge for immediate, but we can also make a quick skill check
        animated_text("You attempt to patch a small motor. Press 'p' quickly when prompted to secure a bolt.", color=theme["text_color"])
        ok = timed_challenge("Secure the bolt! Press 'p' now!", "p", theme, stats, inventory, timeout=4,
                             effects={"success": {"Agility": 1}, "failure": {"Health": -1}}, reward_item=None)
        if ok:
            animated_effect("Motor hummed to life for an instant. You salvage a functioning coil.", "success")
            if "coil" not in inventory:
                inventory.append("coil")
            autosave_if_possible(save_state, stats, inventory)
        else:
            animated_effect("The bolt snaps; your hand stings.", "warning")
        return "workshop"

    if choice == "go storage":
        return "storage"
    if choice == "go hall":
        return "hall"
    if choice == "return":
        return "entry"
    animated_effect("You fumble and do nothing.", "warning")
    return "workshop"


def storage_scene(stats, inventory, theme, save_state):
    animated_text("\nShelves sag with crates. Labels have long since faded.", color=theme["text_color"])

    options = ["open crate", "scavenge tools", "go workshop", "go catwalk", "return"]
    choice = present_choices("Options:", options, theme)

    if choice == "open crate":
        if "oil_can" not in inventory:
            animated_effect("You pry open a crate and find an oil can tucked into straw.", "info")
            inventory.append("oil_can")
            autosave_if_possible(save_state, stats, inventory)
        else:
            animated_effect("The crate is empty save for wood splinters.", "info")
        return "storage"

    if choice == "scavenge tools":
        if "wrench" not in inventory:
            animated_effect("You pick up an old wrench; it might fit stubborn bolts.", "info")
            inventory.append("wrench")
            autosave_if_possible(save_state, stats, inventory)
        else:
            animated_effect("You find nothing else worth carrying.", "info")
        return "storage"

    if choice == "go workshop":
        return "workshop"
    if choice == "go catwalk":
        return "catwalk"
    if choice == "return":
        return "entry"
    animated_effect("You hesitate.", "warning")
    return "storage"


def catwalk_scene(stats, inventory, theme, save_state):
    animated_text("\nYou climb to the catwalk. Below, the factory yawns like a mechanical maw.", color=theme["text_color"])

    options = ["peer down", "follow pipe", "go engine", "go stairs", "return"]
    choice = present_choices("Choices:", options, theme)

    if choice == "peer down":
        animated_text("Glimpses of movement — belts, a lone automaton staggering under a crate — catch your eye.", color=theme["text_color"])
        return "catwalk"
    if choice == "follow pipe":
        animated_text("You trace a steam pipe and find valve markings. Someone tampered with them recently.", color=theme["text_color"])
        return "catwalk"
    if choice == "go engine":
        return "engine_room"
    if choice == "go stairs":
        return "stairs"
    if choice == "return":
        return "entry"
    animated_effect("You falter on the narrow walk.", "warning")
    return "catwalk"


def stairs_scene(stats, inventory, theme, save_state):
    animated_text("\nThe stairs creak under your weight and the smell of oil grows stronger.", color=theme["text_color"])

    options = ["climb up", "search step", "go hall", "go catwalk", "return"]
    choice = present_choices("Actions:", options, theme)

    if choice == "climb up":
        animated_text("You climb carefully and reach a dusty walkway.", color=theme["text_color"])
        return "catwalk"
    if choice == "search step":
        if "matchbox" not in inventory and random.random() < 0.4:
            animated_effect("You find a matchbox wedged under a tread.", "info")
            inventory.append("matchbox")
            autosave_if_possible(save_state, stats, inventory)
        else:
            animated_effect("Only dust and the echo of your footfall.", "info")
        return "stairs"
    if choice == "go hall":
        return "hall"
    if choice == "go catwalk":
        return "catwalk"
    if choice == "return":
        return "entry"
    animated_effect("You hesitate.", "warning")
    return "stairs"


# ---------------------------
# Engine puzzle (multi-stage)
# ---------------------------
def engine_room_scene(stats, inventory, theme, save_state):
    """
    Multi-phase engine puzzle:
     - diagnostics (observe panel)
     - wiring puzzle (connect left->right)
     - final extraction or shutdown
    Success routes to engine_solved; failure may injure player and route back.
    """
    animated_text("\nA faint hum echoes as you near the engine room.", color=theme["text_color"])
    animated_text("The massive generator flickers with unstable light.", color=theme["text_color"])

    # Phase 0: decide whether to run diagnostics or force it
    while True:
        choice = present_choices("Approach the engine:", ["diagnostics", "force", "inspect", "leave"], theme)
        if choice == "diagnostics":
            # Display a small diagnostic readout (flavor)
            animated_text("Phase 1 — Diagnostics: read the flickering panel.", color=theme["text_color"])
            # give an interactive question (not strictly multiple choice)
            panel_choice = present_choices("Which readout is most relevant to wiring repair?", ["voltage", "temperature", "pressure"], theme)
            if panel_choice == "voltage":
                animated_effect("You focus on voltage variances — a clear clue.", "info")
                break
            else:
                animated_effect("You misread the panel; the engine coughs. Try again or inspect.", "warning")
                # small penalty if they repeatedly choose wrong
                if random.random() < 0.25:
                    stats["Health"] = max(0, stats.get("Health", 0) - 1)
                    animated_effect("A minor arc shocks you (-1 Health).", "warning")
                continue

        elif choice == "inspect":
            # Use oil_can to give precise wiring hint (as requested previously)
            if "oil_can" in inventory:
                inventory.remove("oil_can")
                animated_effect("You clean grime away — faint etched labels reveal one correct mapping: Left 2 -> Right 1.", "success")
                # store the revealed hint in save_state for wiring phase
                save_state.setdefault("engine_hints", {})["reveal_one"] = ("2", "1")
            else:
                animated_effect("The panel is grimy. Colored wires hint at pairs (red/blue/green).", "info")
            continue

        elif choice == "force":
            animated_effect("You go for a brute approach — this is risky.", "warning")
            ok = timed_challenge("Smash the access panel! Press 'm' now!", "m", theme, stats, inventory, timeout=3,
                                 effects={"success": {}, "failure": {"Health": -2}}, reward_item=None)
            if ok:
                animated_effect("You ram open the panel, but many wires spark wildly.", "info")
                # force the wiring puzzle to be harder (we'll set a penalty)
                save_state["engine_force"] = True
                break
            else:
                animated_effect("The panel resists and a surge throws you back (-2 Health).", "warning")
                stats["Health"] = max(0, stats.get("Health", 0) - 2)
                return "catwalk"  # thrown back to catwalk

        elif choice == "leave":
            return "catwalk"

        else:
            animated_effect("You pause, unsure.", "warning")

    # Phase 2: wiring puzzle (simple but interactive)
    solved = wiring_puzzle(stats, inventory, theme, save_state)
    if solved:
        save_state["visited"]["engine_solved"] = True
        autosave_if_possible(save_state, stats, inventory)
        return "engine_solved"
    else:
        # failure consequences: player may retreat, injured
        if random.random() < 0.5:
            animated_effect("You are thrown back by a crackle of electricity and scramble away.", "warning")
            stats["Health"] = max(0, stats.get("Health", 0) - 2)
            autosave_if_possible(save_state, stats, inventory)
            return "catwalk"
        else:
            animated_effect("By some luck you avoid further damage but the panel remains angry.", "info")
            return "catwalk"


def wiring_puzzle(stats, inventory, theme, save_state):
    """
    A user-friendly wiring puzzle:
    - There are three left sockets (1..3) and three right sockets (A..C).
    - Player assigns each left to one right.
    - If save_state has 'engine_hints' with 'reveal_one', use it.
    - oil_can removal handled earlier.
    - Provide 'hint' command that reveals color hint; if oil_can was consumed earlier we already stored reveal_one.
    """
    # create a correct map randomly (but stable for this puzzle instance)
    correct_map = save_state.setdefault("engine_correct_map",
                                       { "1": random.choice(["A", "B", "C"]),
                                         "2": random.choice(["A", "B", "C"]),
                                         "3": random.choice(["A", "B", "C"]) })
    # ensure it's a permutation (simple fix)
    # if duplicates, regenerate to be permutation
    vals = list(correct_map.values())
    if len(set(vals)) != 3:
        choices = ["A", "B", "C"]
        random.shuffle(choices)
        correct_map = {"1": choices[0], "2": choices[1], "3": choices[2]}
        save_state["engine_correct_map"] = correct_map

    animated_text("\nWiring Panel: three sockets on the left (1,2,3) and three on the right (A,B,C).", color=theme["text_color"])
    animated_text("Connect them by typing assignments like '1 A' (without quotes). Type 'hint' for hint, 'show' to show current mapping, 'done' to submit.", color=theme["text_color"])

    # if engine_force was set earlier, increase difficulty by shuffling labels visually (flavor only)
    if save_state.get("engine_force"):
        animated_effect("Because you forced the panel, the labels flicker unpredictably. You must be careful.", "warning")

    current_map = {}
    max_attempts = 6
    attempts = 0

    while attempts < max_attempts:
        cmd = spinner_input("Assign (e.g. '1 A'), or command [hint/show/done]: ", theme).strip().lower()
        if not cmd:
            continue
        if cmd in ("show", "s"):
            if current_map:
                animated_text("Current mapping: " + ", ".join([f"{k}->{v}" for k, v in current_map.items()]), color=theme["text_color"])
            else:
                animated_text("No connections made yet.", color=theme["text_color"])
            continue
        if cmd == "hint":
            # if concrete reveal exists (from oil_can), show it
            hints = save_state.get("engine_hints", {})
            if "reveal_one" in hints:
                l, r = hints["reveal_one"]
                animated_effect(f"Etched mark: Left {l} -> Right {r}", "info")
            else:
                animated_effect("The wire colors suggest pairs: red↔red, blue↔blue, green↔green.", "info")
            attempts += 1
            continue
        if cmd == "done":
            # check if mapping matches (must fill all three)
            if set(current_map.keys()) != {"1", "2", "3"}:
                animated_effect("All three left sockets must be assigned before submitting.", "warning")
                continue
            # evaluate correctness
            correct = sum(1 for k, v in current_map.items() if correct_map.get(k) == v)
            if correct == 3:
                animated_effect("All connections hum with a clean note. The panel stabilizes.", "success")
                return True
            elif correct >= 2:
                animated_effect("Most connections are right; a small tweak needed.", "info")
                # allow one more chance
                attempts += 1
                continue
            else:
                animated_effect("The connections spark and the panel throws a warning. Try a# quests/hollowbridge_factory.py
