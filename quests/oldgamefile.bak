SCENE_FUNCTIONS = {
    "entry": entry_scene,
    "hall": hall_scene,
    "workshop": workshop_scene,
    "storage": storage_scene,
    "catwalk": catwalk_scene,
    "stairs": stairs_scene,
    "engine_room": engine_room_scene,
    "engine_solved": engine_solved_scene,
    "control_room": control_room_scene,
    "rescue_worker": rescue_worker_scene,
    "upper_levels": upper_levels_scene,
    "escape_sequence": escape_sequence_scene,
}

def lament_of_hollowbridge_factory(stats, inventory, theme, save_state):
    """
    Main loop for the rewritten, branching factory quest.
    Saves state to save_state dict (visited/choices/notes), autosaves periodically.
    """
    # ensure save_state structure
    save_state.setdefault("visited", {})
    save_state.setdefault("choices", {})
    save_state.setdefault("notes", "")

    # start at entry unless a scene is stored in save_state
    cur = save_state.get("current_scene", "entry")

    while True:
        # if engine solved and we want to continue inside solved route, map names if needed
        scene_fn = SCENE_FUNCTIONS.get(cur)
        if not scene_fn:
            # unknown scene — bail to entry
            animated_effect(f"Scene '{cur}' missing. Returning to entry.", "warning")
            cur = "entry"
            continue

        # call scene
        next_scene = scene_fn(stats, inventory, theme, save_state)

        # update current scene and persist small state
        if next_scene:
            save_state["current_scene"] = next_scene
        else:
            save_state["current_scene"] = cur

        # handle special exit value
        if next_scene == "exit":
            autosave_if_possible(save_state, stats, inventory)
            break

        # loop continues with new scene
        cur = next_scene

    # at quest end return to caller
    return
