from .hall import hall_scene
from .stairs import stairs_scene
from .engine_room import engine_room_scene
from .enter_factory import enter_factory
from scenes.runner import register_scene

def enter_factory(stats, inventory, theme, save_state):
    # minimal: call the runner or provide choices
    while True:
        action = input("[hall/stairs/engine/leave] ")
        if action == "hall":
            hall_scene(stats, inventory, theme, save_state)
        elif action == "stairs":
            climb_stairs(stats, inventory, theme, save_state)
        elif action == "engine":
            approach_engine(stats, inventory, theme, save_state)
        elif action == "leave":
            return

